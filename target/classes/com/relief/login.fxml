<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.LoginController" styleClass="login-root">
    <stylesheets><URL value="@styles.css"/></stylesheets>
    <top>
        <VBox spacing="20" styleClass="login-header">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane minWidth="30" prefWidth="30" maxWidth="30" minHeight="30" prefHeight="30" maxHeight="30" styleClass="brand-icon">
                    <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="KTPeach" styleClass="brand-name"/>
                    <Label text="HURRICANE RELIEF" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Welcome back" styleClass="login-title"/>
                <Label text="Log in to follow your requests and updates." wrapText="true" styleClass="muted"/>
            </VBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="home-scroll">
            <content>
                <VBox spacing="20" fillWidth="true" styleClass="login-content">
                    <VBox spacing="7">
                        <Label text="Email address" labelFor="$txt_email" styleClass="login-field-label"/>
                        <TextField fx:id="txt_email" promptText="you@example.com" styleClass="login-field"/>
                    </VBox>
                    <VBox spacing="7">
                        <Label text="Password" labelFor="$txt_password" styleClass="login-field-label"/>
                        <PasswordField fx:id="txt_password" promptText="Enter your password" styleClass="login-field"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Hyperlink text="Forgot password?" styleClass="login-link, login-forgot"/>
                        </HBox>
                    </VBox>
                    <Button fx:id="loginButton" maxWidth="Infinity" minHeight="46" prefHeight="46" maxHeight="46" styleClass="create-button" accessibleText="Log in">
                        <graphic>
                            <HBox prefWidth="${loginButton.width - 30}" alignment="CENTER_LEFT" fillHeight="false" spacing="10">
                                <Label text="Log in" styleClass="create-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <SVGPath content="M 3 12 L 21 12 M 14 5 L 21 12 L 14 19" styleClass="icon"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <HBox alignment="CENTER" spacing="3">
                        <Label text="New here?"/>
                        <Hyperlink text="Create an account" onAction="#showSignup" styleClass="login-link"/>
                    </HBox>
                    <HBox spacing="12" fillHeight="false" alignment="CENTER_LEFT" minHeight="66" prefHeight="66" maxHeight="66" styleClass="login-protection">
                        <StackPane minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24">
                            <SVGPath content="M 12 2 L 21 6 L 21 12 C 21 17 16 21 12 23 C 8 21 3 17 3 12 L 3 6 Z M 7 12 L 11 16 L 17 9" styleClass="icon, login-shield"/>
                        </StackPane>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS">
                            <Label text="Your information stays protected" wrapText="true" styleClass="login-protection-title"/>
                            <Label text="Shared only to coordinate your request." wrapText="true" styleClass="login-protection-note"/>
                        </VBox>
                    </HBox>
                    <Region minHeight="0" prefHeight="0" VBox.vgrow="ALWAYS"/>
                    <Button fx:id="guestButton" maxWidth="Infinity" minHeight="66" prefHeight="66" maxHeight="66" styleClass="login-guest" accessibleText="Find a shelter without an account">
                        <graphic>
                            <HBox prefWidth="${guestButton.width - 30}" minHeight="40" prefHeight="40" maxHeight="40" alignment="CENTER_LEFT" fillHeight="false" spacing="12">
                                <StackPane minWidth="24" prefWidth="24" maxWidth="24" minHeight="24" prefHeight="24" maxHeight="24">
                                    <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                                </StackPane>
                                <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Need a safe place right now?" wrapText="true" styleClass="login-guest-title"/>
                                    <Label text="Find a shelter without an account" wrapText="true" styleClass="login-note"/>
                                </VBox>
                                <SVGPath content="M 3 12 L 21 12 M 14 5 L 21 12 L 14 19" styleClass="icon, login-small-arrow"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Label text="Immediate danger? Call 911" maxWidth="Infinity" alignment="CENTER" styleClass="login-note"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
