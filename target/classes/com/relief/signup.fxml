<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SignupController" styleClass="auth-root">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>
    <top>
        <VBox styleClass="home-header, auth-header" spacing="18">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane minWidth="28" prefWidth="28" maxWidth="28" minHeight="28" prefHeight="28" maxHeight="28" styleClass="brand-icon">
                    <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="KTPeach" styleClass="brand-name"/>
                    <Label text="HURRICANE RELIEF" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Create an account" wrapText="true" styleClass="auth-title"/>
                <Label text="Keep track of your family’s requests." wrapText="true" styleClass="muted"/>
            </VBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll" pannable="true">
            <content>
                <VBox styleClass="auth-content" spacing="20" fillWidth="true">
                    <HBox spacing="12">
                        <VBox spacing="7" minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS">
                            <Label text="First name" labelFor="$txt_firstName" styleClass="auth-field-label"/>
                            <TextField fx:id="txt_firstName" onAction="#signup" promptText="First name" minWidth="0" styleClass="auth-field"/>
                        </VBox>
                        <VBox spacing="7" minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS">
                            <Label text="Last name" labelFor="$txt_lastName" styleClass="auth-field-label"/>
                            <TextField fx:id="txt_lastName" onAction="#signup" promptText="Last name" minWidth="0" styleClass="auth-field"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="7">
                        <Label text="Email address" labelFor="$txt_email" styleClass="auth-field-label"/>
                        <TextField fx:id="txt_email" onAction="#signup" promptText="you@example.com" styleClass="auth-field"/>
                    </VBox>
                    <VBox spacing="7">
                        <Label text="Password" labelFor="$txt_password" styleClass="auth-field-label"/>
                        <StackPane>
                            <PasswordField fx:id="txt_password" promptText="Create a password" styleClass="auth-field" onAction="#signup"/>
                            <TextField fx:id="txt_visiblePassword" promptText="Create a password" styleClass="auth-field" onAction="#signup" visible="false" managed="false"/>
                        </StackPane>
                        <CheckBox fx:id="showPasswordCheckBox" text="Show password"/>
                        <Label text="Use at least 8 characters." styleClass="auth-hint"/>
                    </VBox>
                    <VBox spacing="3" styleClass="auth-terms">
                        <Label text="By creating an account, you agree to our" wrapText="true" styleClass="auth-hint"/>
                        <HBox alignment="CENTER_LEFT" spacing="3">
                            <Hyperlink text="Terms of Service" styleClass="auth-policy-link"/>
                            <Label text="and" styleClass="auth-hint"/>
                            <Hyperlink text="Privacy Policy" styleClass="auth-policy-link"/>
                            <Label text="." styleClass="auth-hint"/>
                        </HBox>
                    </VBox>
                    <Label fx:id="feedback" wrapText="true" visible="false" managed="false" styleClass="auth-feedback"/>
                    <Button fx:id="submitButton" onAction="#signup" maxWidth="Infinity" styleClass="create-button, auth-submit" accessibleText="Create account">
                        <graphic>
                            <HBox prefWidth="${submitButton.width - 30}" alignment="CENTER_LEFT" spacing="10">
                                <Label text="Create account" styleClass="create-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <SVGPath content="M 3 12 L 21 12 M 14 5 L 21 12 L 14 19" styleClass="icon"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <HBox alignment="CENTER" spacing="2">
                        <Label text="Already have an account?" styleClass="auth-switch-prompt"/>
                        <Hyperlink text="Log in" onAction="#showLogin" styleClass="auth-switch-link"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="18" styleClass="auth-footer">
            <Button fx:id="guestButton" minHeight="66" prefHeight="66" maxHeight="66" VBox.vgrow="NEVER" maxWidth="Infinity" styleClass="auth-guest" accessibleText="Find a shelter without an account">
                <graphic>
                    <HBox prefWidth="${guestButton.width - 30}" minHeight="40" prefHeight="40" maxHeight="40" fillHeight="false" alignment="CENTER_LEFT" spacing="12">
                        <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                            <Label text="Need a safe place right now?" wrapText="true" styleClass="auth-guest-title"/>
                            <Label text="Find a shelter without an account" wrapText="true" styleClass="auth-hint"/>
                        </VBox>
                        <SVGPath content="M 3 12 L 21 12 M 14 5 L 21 12 L 14 19" styleClass="icon, auth-small-arrow"/>
                    </HBox>
                </graphic>
            </Button>
            <Label text="Immediate danger? Call 911" alignment="CENTER" maxWidth="Infinity" styleClass="auth-hint"/>
        </VBox>
    </bottom>
</BorderPane>
