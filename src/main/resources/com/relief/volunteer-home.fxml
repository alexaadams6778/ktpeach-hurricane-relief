<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.VolunteerHomeController" styleClass="home-root">
    <stylesheets><URL value="@styles.css"/></stylesheets>
    <top>
        <VBox spacing="16" styleClass="home-header">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane minWidth="36" prefWidth="36" maxWidth="36" minHeight="36" prefHeight="36" maxHeight="36" styleClass="brand-icon">
                    <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="KTPeach" styleClass="brand-name"/>
                    <Label text="HURRICANE RELIEF" styleClass="brand-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="profileButton" text="?" styleClass="avatar" accessibleText="Open profile"/>
            </HBox>
            <VBox spacing="5">
                <Label fx:id="greetingLabel" text="Hi!" styleClass="greeting"/>
                <Label fx:id="volunteerNameLabel" text="Volunteer" wrapText="true" styleClass="muted"/>
            </VBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll">
            <content>
                <VBox spacing="22" fillWidth="true" styleClass="home-content">
                    <VBox spacing="7" styleClass="volunteer-specialty">
                        <Label text="YOUR SPECIALTY" styleClass="volunteer-specialty-caption"/>
                        <Label fx:id="specialtyLabel" text="Specialty not set" wrapText="true" styleClass="volunteer-specialty-title"/>
                    </VBox>
                    <VBox spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Nearby open requests" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="0 open" styleClass="muted, volunteer-request-count"/>
                        </HBox>
                        <Label text="No current requests" wrapText="true" styleClass="muted"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" fillHeight="false" spacing="8" styleClass="bottom-nav">
            <Button minWidth="0" prefWidth="0" maxWidth="Infinity" minHeight="44" prefHeight="44" maxHeight="44" HBox.hgrow="ALWAYS" styleClass="nav-button, nav-selected" onAction="#refresh" accessibleText="Home">
                <graphic>
                    <VBox alignment="CENTER" spacing="5">
                        <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                        <Label text="Home" styleClass="nav-label"/>
                    </VBox>
                </graphic>
            </Button>
            <Button minWidth="0" prefWidth="0" maxWidth="Infinity" minHeight="44" prefHeight="44" maxHeight="44" HBox.hgrow="ALWAYS" styleClass="nav-button" accessibleText="Requests">
                <graphic>
                    <VBox alignment="CENTER" spacing="5">
                        <SVGPath content="M 6 2 L 16 2 L 20 6 L 20 22 L 6 22 Z M 9 9 L 17 9 M 9 13 L 17 13 M 9 17 L 15 17" styleClass="icon"/>
                        <Label text="Requests" styleClass="nav-label"/>
                    </VBox>
                </graphic>
            </Button>
            <Button minWidth="0" prefWidth="0" maxWidth="Infinity" minHeight="44" prefHeight="44" maxHeight="44" HBox.hgrow="ALWAYS" styleClass="nav-button" accessibleText="Shelters">
                <graphic>
                    <VBox alignment="CENTER" spacing="5">
                        <SVGPath content="M 2 10 L 12 2 L 22 10 M 5 8 L 5 22 L 10 22 L 10 14 L 14 14 L 14 22 L 19 22 L 19 8" styleClass="icon"/>
                        <Label text="Shelters" styleClass="nav-label"/>
                    </VBox>
                </graphic>
            </Button>
            <Button minWidth="0" prefWidth="0" maxWidth="Infinity" minHeight="44" prefHeight="44" maxHeight="44" HBox.hgrow="ALWAYS" styleClass="nav-button" accessibleText="Profile">
                <graphic>
                    <VBox alignment="CENTER" spacing="5">
                        <SVGPath content="M 16 6 A 4 4 0 1 1 8 6 A 4 4 0 1 1 16 6 M 4 22 L 4 19 C 4 13 20 13 20 19 L 20 22" styleClass="icon"/>
                        <Label text="Profile" styleClass="nav-label"/>
                    </VBox>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
